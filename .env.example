# Copy this file to .env and fill in the values locally.
# Never commit .env or share an app password.
GMAIL_ADDRESS=your.test.account@gmail.com
GMAIL_APP_PASSWORD=replace_with_16_character_app_password
GMAIL_MAILBOX=INBOX
# UNSEEN is safest for the first test. Keep your test email unread.
# Use ALL only if you deliberately want to scan all mail in the test mailbox.
GMAIL_SEARCH=UNSEEN
# Optional: defaults to ./data/incoming
# GMAIL_DOWNLOAD_DIR=data/incoming
